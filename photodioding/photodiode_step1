"""Step 1: photodiode sanity check (NI USB-6211 + eemagine XS-355).

Wiring: white -> AI0, AI8 jumpered to AI GND, black -> AI GND, red -> +5V.
Run on the stim PC. Opens a fullscreen window on the ASUS with a patch in the
center and walks through four readings: covered, black, white, 20 s white hold.
Each step shows a live reading; press SPACE to measure, ESC to quit.
No gamma correction is applied (black and white are unaffected by gamma anyway).
"""
import sys
import datetime
import numpy as np
import nidaqmx
import nidaqmx.system
from nidaqmx.constants import TerminalConfiguration as TC, AcquisitionType, READ_ALL_AVAILABLE
from psychopy import visual, event, core

# ---- settings -------------------------------------------------------------
SCREEN = 0        # PsychoPy screen index of the ASUS (same as in config_local.py)
FS = 10000        # sample rate, Hz
V_RANGE = 10.0    # +/- volts; switch to 0.2 once levels are confirmed
PATCH_PX = 300    # patch size in pixels; must be larger than the sensor face
BG = 0.0          # background, PsychoPy rgb (-1..1); 0 = mid gray
SETTLE_S = 0.5    # wait after SPACE before measuring (hand off, signal settles)

STEPS = [  # name, patch level, seconds, instruction
    ("covered",    -1,  1.0, "Cover the sensor completely (no light reaching it)."),
    ("black",      -1,  1.0, "Place the sensor on the center patch (black)."),
    ("white",       1,  1.0, "Keep the sensor on the patch (now white)."),
    ("white_hold",  1, 20.0, "Keep the sensor on the patch. 20 s white hold."),
]

# ---- find the DAQ -----------------------------------------------------------
devices = list(nidaqmx.system.System.local().devices)
if not devices:
    sys.exit("No NI device found. Check the USB cable and that NI MAX sees the DAQ.")
dev = next((d for d in devices if "6211" in d.product_type), devices[0])
print(f"Using {dev.name} ({dev.product_type})")

# ---- display ------------------------------------------------------------------
win = visual.Window(screen=SCREEN, fullscr=True, color=BG, units="pix")
patch = visual.Rect(win, width=PATCH_PX, height=PATCH_PX, lineColor=None, fillColor=-1)
msg = visual.TextStim(win, pos=(0, -win.size[1] / 2 + 100), height=24, color=0.6,
                      wrapWidth=win.size[0] * 0.8)


def pull(task):
    """Return all samples currently in the DAQ buffer as a float array (volts)."""
    return np.asarray(task.read(number_of_samples_per_channel=READ_ALL_AVAILABLE), dtype=float)


def show(text):
    msg.text = text
    patch.draw()
    msg.draw()
    win.flip()


def abort(task):
    task.stop()
    win.close()
    core.quit()


raw, lines = {}, []
with nidaqmx.Task() as t:
    t.ai_channels.add_ai_voltage_chan(f"{dev.name}/ai0", terminal_config=TC.DIFF,
                                      min_val=-V_RANGE, max_val=V_RANGE)
    t.timing.cfg_samp_clk_timing(FS, sample_mode=AcquisitionType.CONTINUOUS,
                                 samps_per_chan=FS * 60)
    t.start()

    for name, level, dur, instr in STEPS:
        patch.fillColor = level

        # live preview until SPACE
        live = np.zeros(0)
        event.clearEvents()
        while True:
            live = np.concatenate([live, pull(t)])[-FS // 2:]
            if live.size:
                reading = f"live: {live.mean() * 1e3:8.3f} mV   sd {live.std() * 1e3:6.3f} mV"
            else:
                reading = "live: waiting for samples"
            show(f"{instr}\n{reading}\nSPACE = measure {dur:g} s     ESC = quit")
            keys = event.getKeys(["space", "escape"])
            if "escape" in keys:
                abort(t)
            if "space" in keys:
                break

        # settle, discard, then measure
        show(f"Measuring {name} ({dur:g} s)... keep still")
        core.wait(SETTLE_S)
        pull(t)
        need, chunks, n = int(dur * FS), [], 0
        while n < need:
            c = pull(t)
            chunks.append(c)
            n += c.size
            show(f"Measuring {name} ({dur:g} s)... keep still")
            if "escape" in event.getKeys(["escape"]):
                abort(t)
        x = np.concatenate(chunks)[:need]
        raw[name] = x

        clipped = np.mean(np.abs(x) >= 0.99 * V_RANGE)
        line = (f"{name:11s} mean {x.mean() * 1e3:8.3f} mV   sd {x.std() * 1e3:6.3f} mV   "
                f"min {x.min() * 1e3:8.3f}   max {x.max() * 1e3:8.3f}")
        if clipped > 0:
            line += f"   CLIPPED {clipped:.1%}"
        lines.append(line)
        print(line)

    t.stop()

# ---- droop check on the 20 s hold ----------------------------------------------
h = raw["white_hold"]
first, last = h[:FS].mean(), h[-FS:].mean()
swing = raw["white"].mean() - raw["covered"].mean()
droop = (last - first) / swing * 100 if swing != 0 else float("nan")
lines.append(f"white_hold  first 1 s {first * 1e3:.3f} mV   last 1 s {last * 1e3:.3f} mV   "
             f"change {droop:+.2f}% of white-minus-covered")
print(lines[-1])

stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
fname = f"photodiode_step1_{stamp}.npz"
np.savez(fname, fs=FS, v_range=V_RANGE, device=dev.name, **raw)
print(f"Raw samples saved to {fname}")

patch.fillColor = BG
show("\n".join(lines) + "\n\nAny key to close.")
event.waitKeys()
win.close()
core.quit()